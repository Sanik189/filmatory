@page "/"
@implements IDisposable
@inject MovieLibraryState Library

<PageTitle>POP Movies</PageTitle>

@{
    var filteredMovies = Library.FilteredMovies;
    var recommendations = Library.Recommendations;
    var selectedMovie = Library.SelectedMovie;
    var recentMovies = Library.RecentMovies;
}

<section class="hero-card panel">
    <div class="hero-copy">
        <span class="eyebrow">Сайт для открытия фильмов, а не для просмотра</span>
        <h2>Название, описание, умный поиск и рекомендации, которые меняются от ваших последних просмотров.</h2>
        <p>
            Выбирайте несколько жанров одновременно, открывайте карточки фильмов и ставьте оценки —
            Blazor-сервис запоминает последние действия прямо в сессии и перестраивает выдачу без базы данных.
        </p>

        <div class="hero-stats">
            <article>
                <strong>@Library.TotalMovies</strong>
                <span>фильмов в каталоге</span>
            </article>
            <article>
                <strong>@Library.AvailableGenres.Count</strong>
                <span>жанров в умном поиске</span>
            </article>
            <article>
                <strong>@Library.TotalRatings</strong>
                <span>оценок уже учитывается</span>
            </article>
        </div>
    </div>

    <div class="hero-side">
        <div class="floating-card">
            <span>Персонализация</span>
            <h3>@(selectedMovie?.Title ?? recommendations.FirstOrDefault()?.Movie.Title ?? "Neon Harbor")</h3>
            <p>
                @(selectedMovie is null
                    ? "Откройте любую карточку, чтобы закрепить последний просмотр и увидеть точнее подобранные рекомендации."
                    : Library.DescribeRecommendation(selectedMovie))
            </p>
        </div>
    </div>
</section>

<section id="search" class="panel controls-panel">
    <div class="controls-top">
        <div>
            <span class="section-label">Smart search</span>
            <h3>Выбор сразу нескольких жанров</h3>
        </div>

        <button type="button" class="clear-button" @onclick="Library.ClearFilters">Сбросить фильтры</button>
    </div>

    <div class="search-row">
        <label class="search-field">
            <span>Поиск по названию, описанию или тегам</span>
            <input
                value="@Library.SearchQuery"
                @oninput="HandleSearchInput"
                placeholder="Например: space, city, family"
                autocomplete="off" />
        </label>

        <label class="sort-field">
            <span>Сортировка</span>
            <select value="@Library.SortMode" @onchange="HandleSortChange">
                @foreach (var option in Library.SortOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </label>
    </div>

    <div class="genre-wrap">
        @foreach (var genre in Library.AvailableGenres)
        {
            <button
                type="button"
                class="genre-chip @(Library.SelectedGenres.Contains(genre) ? "is-selected" : string.Empty)"
                @onclick="() => Library.ToggleGenre(genre)">
                @genre
            </button>
        }
    </div>

    <div class="filter-summary">
        <span>@Library.StatusSummary</span>
        <span>@(Library.SelectedGenres.Count == 0 ? "Жанры не ограничены" : string.Join(", ", Library.SelectedGenres))</span>
    </div>
</section>

<section class="workspace-grid">
    <article id="catalog" class="panel catalog-panel">
        <div class="section-heading">
            <div>
                <span class="section-label">Каталог</span>
                <h3>Фильмы, которые подходят под текущий вкус</h3>
            </div>
            <span class="count-pill">@filteredMovies.Count</span>
        </div>

        @if (filteredMovies.Count == 0)
        {
            <div class="empty-state">
                <h4>Ничего не найдено</h4>
                <p>Снимите часть жанров или попробуйте более широкий запрос.</p>
            </div>
        }
        else
        {
            <div class="movie-grid">
                @foreach (var movie in filteredMovies)
                {
                    <article class="movie-card @(Library.SelectedMovieId == movie.Id ? "is-selected" : string.Empty)" @onclick="() => Library.SelectMovie(movie)">
                        <div class="movie-card-top">
                            <div>
                                <span class="year-pill">@movie.Year</span>
                                <h4>@movie.Title</h4>
                            </div>
                            <span class="rating-pill">@movie.CommunityScore.ToString("0.0")</span>
                        </div>

                        <p>@movie.Description</p>

                        <div class="meta-line">
                            <span>@movie.Duration</span>
                            <span>@movie.Spotlight</span>
                        </div>

                        <div class="chip-row">
                            @foreach (var genre in movie.Genres)
                            {
                                <span class="genre-tag">@genre</span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </article>

    <aside class="side-column">
        <section id="recommendations" class="panel rail-panel">
            <div class="section-heading compact">
                <div>
                    <span class="section-label">Рекомендации</span>
                    <h3>Подстраиваются под последние просмотры и оценки</h3>
                </div>
            </div>

            <div class="recommendation-stack">
                @foreach (var recommendation in recommendations)
                {
                    <article class="recommendation-card" @onclick="() => Library.SelectMovie(recommendation.Movie)">
                        <div class="recommendation-card-top">
                            <div>
                                <h4>@recommendation.Movie.Title</h4>
                                <p>@recommendation.Reason</p>
                            </div>
                            <span class="score-chip">@recommendation.Score</span>
                        </div>

                        <div class="chip-row">
                            @foreach (var genre in recommendation.MatchingGenres)
                            {
                                <span class="genre-tag accent">@genre</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="panel details-panel">
            <div class="section-heading compact">
                <div>
                    <span class="section-label">Карточка</span>
                    <h3>@(selectedMovie?.Title ?? "Выберите фильм")</h3>
                </div>
            </div>

            @if (selectedMovie is not null)
            {
                <p class="detail-description">@selectedMovie.Description</p>

                <div class="detail-grid">
                    <div>
                        <span>Год</span>
                        <strong>@selectedMovie.Year</strong>
                    </div>
                    <div>
                        <span>Длительность</span>
                        <strong>@selectedMovie.Duration</strong>
                    </div>
                    <div>
                        <span>Рейтинг каталога</span>
                        <strong>@selectedMovie.CommunityScore.ToString("0.0")</strong>
                    </div>
                </div>

                <div class="rating-section">
                    <span>Ваша оценка</span>
                    <div class="star-row">
                        @for (var rating = 1; rating <= 5; rating++)
                        {
                            var currentRating = rating;
                            <button
                                type="button"
                                class="star-button @(Library.GetRating(selectedMovie) >= currentRating ? "active" : string.Empty)"
                                @onclick="() => Library.RateMovie(selectedMovie, currentRating)">
                                ★
                            </button>
                        }
                    </div>
                </div>

                <div class="chip-row">
                    @foreach (var genre in selectedMovie.Genres)
                    {
                        <span class="genre-tag">@genre</span>
                    }
                </div>
            }
            else
            {
                <p class="detail-description muted">
                    Кликните по любому фильму, чтобы добавить его в недавние просмотры и оценить его.
                </p>
            }
        </section>

        <section class="panel history-panel">
            <div class="section-heading compact">
                <div>
                    <span class="section-label">Недавние просмотры</span>
                    <h3>История, на которой строятся рекомендации</h3>
                </div>
            </div>

            @if (recentMovies.Count == 0)
            {
                <p class="muted">Пока пусто. Откройте несколько карточек, чтобы персонализация стала заметнее.</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var movie in recentMovies)
                    {
                        <button type="button" class="history-item" @onclick="() => Library.SelectMovie(movie)">
                            <span>@movie.Title</span>
                            <small>@movie.Year</small>
                        </button>
                    }
                </div>
            }
        </section>
    </aside>
</section>

@code {
    protected override void OnInitialized()
    {
        Library.Changed += HandleLibraryChanged;
    }

    private void HandleLibraryChanged() => InvokeAsync(StateHasChanged);

    private void HandleSearchInput(ChangeEventArgs eventArgs)
    {
        Library.SetSearchQuery(eventArgs.Value?.ToString() ?? string.Empty);
    }

    private void HandleSortChange(ChangeEventArgs eventArgs)
    {
        Library.SetSortMode(eventArgs.Value?.ToString() ?? string.Empty);
    }

    public void Dispose()
    {
        Library.Changed -= HandleLibraryChanged;
    }
}
