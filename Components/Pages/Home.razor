@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject MovieLibraryState Library
@inject LocalizationState Loc

<PageTitle>Filmatory</PageTitle>

@{
    var catalogMovies = Library.CatalogMovies;
    var recommendations = Library.Recommendations;
    var selectedMovie = Library.SelectedMovie;
    var recentMovies = Library.RecentMovies;
}

<section class="hero-card panel">
    <div class="hero-copy">
        <span class="eyebrow">@Loc.T("hero.eyebrow")</span>
        <h2>@Loc.T("hero.title")</h2>
        <p>@Loc.T("hero.subtitle")</p>

        <div class="hero-stats">
            <article>
                <strong>@Library.CatalogSize.ToString("N0")</strong>
                <span>@Loc.T("hero.stat.movies")</span>
            </article>
            <article>
                <strong>@Library.AvailableGenres.Count</strong>
                <span>@Loc.T("hero.stat.genres")</span>
            </article>
            <article>
                <strong>@Library.TotalRatings</strong>
                <span>@Loc.T("hero.stat.ratings")</span>
            </article>
        </div>
    </div>

    <div class="hero-side">
        <div class="floating-card">
            <span>@Loc.T("hero.personalization")</span>
            <h3>@(selectedMovie?.Title ?? recommendations.FirstOrDefault()?.Movie.Title ?? Loc.T("hero.nextMovie"))</h3>
            <p>
                @(selectedMovie is null
                    ? Loc.T("hero.openHint")
                    : Library.DescribeRecommendation(selectedMovie))
            </p>
        </div>
    </div>
</section>

@if (Library.ErrorMessage is not null)
{
    <section class="panel error-banner">
        <strong>@Loc.T("error.title")</strong>
        <p>@Library.ErrorMessage</p>
    </section>
}

<section id="search" class="panel controls-panel">
    <div class="controls-top">
        <div>
            <span class="section-label">@Loc.T("search.label")</span>
            <h3>@Loc.T("search.heading")</h3>
        </div>

        <button type="button" class="clear-button" @onclick="Library.ClearFilters">@Loc.T("search.clear")</button>
    </div>

    <div class="search-row">
        <label class="search-field">
            <span>@Loc.T("search.inputLabel")</span>
            <input
                value="@Library.SearchQuery"
                @oninput="HandleSearchInput"
                placeholder="@Loc.T("search.placeholder")"
                autocomplete="off" />
        </label>

        <label class="sort-field">
            <span>@Loc.T("search.sortLabel")</span>
            <select value="@Library.SortMode" @onchange="HandleSortChange">
                @foreach (var option in Library.SortOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
        </label>
    </div>

    <div class="content-type-switch">
        <button type="button" class="type-filter-btn @(Library.CurrentContentFilter == ContentFilter.Mixed ? "is-active" : string.Empty)" @onclick="() => Library.SetContentFilter(ContentFilter.Mixed)">@Loc.T("mediaType.all")</button>
        <button type="button" class="type-filter-btn @(Library.CurrentContentFilter == ContentFilter.MoviesOnly ? "is-active" : string.Empty)" @onclick="() => Library.SetContentFilter(ContentFilter.MoviesOnly)">@Loc.T("mediaType.movies")</button>
        <button type="button" class="type-filter-btn @(Library.CurrentContentFilter == ContentFilter.SeriesOnly ? "is-active" : string.Empty)" @onclick="() => Library.SetContentFilter(ContentFilter.SeriesOnly)">@Loc.T("mediaType.series")</button>
    </div>

    <div class="genre-wrap">
        @foreach (var genre in Library.AvailableGenres)
        {
            <button
                type="button"
                class="genre-chip @(Library.SelectedGenreNames.Contains(genre.Name) ? "is-selected" : string.Empty)"
                @onclick="() => Library.ToggleGenre(genre.Name)">
                @genre.Name
            </button>
        }
    </div>

    <div class="filter-summary">
        <span>@Library.StatusSummary</span>
        <span>@(Library.SelectedGenreNames.Count == 0 ? Loc.T("search.genresUnrestricted") : string.Join(", ", Library.SelectedGenreNames))</span>
    </div>
</section>

<section class="workspace-grid">
    <article id="catalog" class="panel catalog-panel">
        <div class="section-heading">
            <div>
                <span class="section-label">@Loc.T("catalog.label")</span>
                <h3>@Loc.T("catalog.heading")</h3>
            </div>
            <span class="count-pill">@catalogMovies.Count</span>
        </div>

        @if (Library.SortMode == "recommended" && Library.SelectedGenreNames.Count == 0 && !Library.IsPersonalizedCatalog && !Library.IsLoading)
        {
            <p class="muted personalization-hint">@Loc.T("catalog.personalizationHint")</p>
        }

        @if (Library.IsLoading)
        {
            <div class="movie-grid">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="movie-card skeleton"></div>
                }
            </div>
        }
        else if (catalogMovies.Count == 0)
        {
            <div class="empty-state">
                <h4>@Loc.T("catalog.empty.title")</h4>
                <p>@Loc.T("catalog.empty.body")</p>
            </div>
        }
        else
        {
            <div class="movie-grid">
                @foreach (var movie in catalogMovies)
                {
                    <article class="movie-card @(Library.SelectedMovieKey == movie.Key ? "is-selected" : string.Empty)" @onclick="() => Library.SelectMovie(movie)">
                        <button type="button" class="not-interested-btn" title="@Loc.T("card.notInterestedAria")" aria-label="@Loc.T("card.notInterestedAria")" @onclick="() => Library.MarkNotInterested(movie)" @onclick:stopPropagation="true">✕</button>

                        <div class="movie-poster">
                            @if (movie.PosterUrl is not null)
                            {
                                <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="poster-placeholder">@movie.Title.Substring(0, 1)</span>
                            }
                        </div>

                        <div class="movie-card-body">
                            <div class="movie-card-top">
                                <div>
                                    <span class="year-pill">@(movie.Year?.ToString() ?? "—")</span>
                                    <span class="type-tag">@(movie.Type == MediaType.Tv ? Loc.T("mediaType.tv") : Loc.T("mediaType.movie"))</span>
                                    <h4>@movie.Title</h4>
                                </div>
                                <span class="rating-pill">@movie.ScoreLabel</span>
                            </div>

                            <p>@movie.Overview</p>

                            <div class="chip-row">
                                @foreach (var genre in movie.Genres.Take(3))
                                {
                                    <span class="genre-tag">@genre</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            @if (Library.CanLoadMore)
            {
                <button type="button" class="load-more-button" @onclick="Library.LoadMore">@Loc.T("catalog.loadMore")</button>
            }
            else if (Library.IsLoadingMore)
            {
                <div class="load-more-status">@Loc.T("catalog.loading")</div>
            }
        }
    </article>

    <aside class="side-column">
        <section id="recommendations" class="panel rail-panel">
            <div class="section-heading compact">
                <div>
                    <span class="section-label">@Loc.T("recs.label")</span>
                    <h3>@Loc.T("recs.heading")</h3>
                </div>
            </div>

            @if (recommendations.Count == 0)
            {
                <p class="muted">@Loc.T("recs.empty")</p>
            }
            else
            {
                <div class="recommendation-stack">
                    @foreach (var recommendation in recommendations)
                    {
                        <article class="recommendation-card" @onclick="() => Library.SelectMovie(recommendation.Movie)">
                            <button type="button" class="not-interested-btn" title="@Loc.T("card.notInterestedAria")" aria-label="@Loc.T("card.notInterestedAria")" @onclick="() => Library.MarkNotInterested(recommendation.Movie)" @onclick:stopPropagation="true">✕</button>

                            <div class="movie-poster small">
                                @if (recommendation.Movie.PosterUrl is not null)
                                {
                                    <img src="@recommendation.Movie.PosterUrl" alt="@recommendation.Movie.Title" loading="lazy" />
                                }
                                else
                                {
                                    <span class="poster-placeholder">@recommendation.Movie.Title.Substring(0, 1)</span>
                                }
                            </div>

                            <div class="recommendation-card-body">
                                <div class="recommendation-card-top">
                                    <div>
                                        <h4>@recommendation.Movie.Title</h4>
                                        <p>@recommendation.Reason</p>
                                    </div>
                                    <span class="score-chip">@recommendation.Score.ToString("0")</span>
                                </div>

                                <div class="chip-row">
                                    @foreach (var genre in recommendation.MatchingGenres)
                                    {
                                        <span class="genre-tag accent">@genre</span>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel history-panel">
            <div class="section-heading compact">
                <div>
                    <span class="section-label">@Loc.T("history.label")</span>
                    <h3>@Loc.T("history.heading")</h3>
                </div>
            </div>

            @if (!Library.IsAuthenticated)
            {
                <p class="muted auth-hint">
                    <a href="/account/login">@Loc.T("history.authHint.login")</a> @Loc.T("history.authHint.or")
                    <a href="/account/register">@Loc.T("history.authHint.register")</a>,
                    @Loc.T("history.authHint.suffix")
                </p>
            }

            @if (recentMovies.Count == 0)
            {
                <p class="muted">@Loc.T("history.empty")</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var movie in recentMovies)
                    {
                        <button type="button" class="history-item" @onclick="() => Library.SelectMovie(movie)">
                            <span>@movie.Title</span>
                            <small>@(movie.Year?.ToString() ?? "—")</small>
                        </button>
                    }
                </div>
            }
        </section>
    </aside>
</section>

@if (selectedMovie is not null)
{
    <div class="modal-overlay" @onclick="Library.CloseDetail">
        <div class="modal-card" @onclick:stopPropagation="true">
            <button type="button" class="modal-close" @onclick="Library.CloseDetail">✕</button>

            @if (selectedMovie.BackdropUrl is not null)
            {
                <div class="modal-backdrop" style="background-image:url('@selectedMovie.BackdropUrl')"></div>
            }

            <div class="modal-body">
                <div class="modal-poster">
                    @if (selectedMovie.PosterUrl is not null)
                    {
                        <img src="@selectedMovie.PosterUrl" alt="@selectedMovie.Title" />
                    }
                    else
                    {
                        <span class="poster-placeholder">@selectedMovie.Title.Substring(0, 1)</span>
                    }
                </div>

                <div class="modal-info">
                    <h3>@selectedMovie.Title</h3>

                    <div class="chip-row">
                        @foreach (var genre in selectedMovie.Genres)
                        {
                            <span class="genre-tag">@genre</span>
                        }
                    </div>

                    <div class="modal-actions">
                        @if (Library.SelectedTrailerKey is string trailerKey)
                        {
                            <a class="modal-action-btn" href="@($"https://www.youtube.com/watch?v={trailerKey}")" target="_blank" rel="noopener">@Loc.T("modal.trailer")</a>
                        }

                        <button type="button" class="modal-action-btn @(Library.IsInWatchlist(selectedMovie) ? "is-active" : string.Empty)" @onclick="() => Library.ToggleWatchlist(selectedMovie)">
                            @(Library.IsInWatchlist(selectedMovie) ? Loc.T("modal.watchlist.remove") : Loc.T("modal.watchlist.add"))
                        </button>
                    </div>

                    <p class="detail-description">@selectedMovie.Overview</p>

                    <div class="detail-grid">
                        <div>
                            <span>@Loc.T("modal.year")</span>
                            <strong>@(selectedMovie.Year?.ToString() ?? Loc.T("modal.noYear"))</strong>
                        </div>
                        <div>
                            <span>@Loc.T("modal.duration")</span>
                            <strong>@selectedMovie.DurationLabel</strong>
                        </div>
                        <div>
                            <span>@Loc.T("modal.rating")</span>
                            <strong>@selectedMovie.ScoreLabel</strong>
                        </div>
                    </div>

                    <div class="rating-section">
                        <span>@Loc.T("modal.yourRating")</span>
                        <div class="star-row">
                            @for (var rating = 1; rating <= 5; rating++)
                            {
                                var currentRating = rating;
                                <button
                                    type="button"
                                    class="star-button @(Library.GetRating(selectedMovie) >= currentRating ? "active" : string.Empty)"
                                    @onclick="() => Library.RateMovie(selectedMovie, currentRating)">
                                    ★
                                </button>
                            }
                        </div>
                        @if (!Library.IsAuthenticated)
                        {
                            <p class="muted auth-hint"><a href="/account/login">@Loc.T("modal.loginPrefix")</a>@Loc.T("modal.loginSuffix")</p>
                        }
                    </div>

                    @if (Library.SelectedWatchProviders is { HasAny: true } providers)
                    {
                        <div class="watch-providers">
                            <span class="watch-providers-label">@Loc.T("modal.whereToWatch")</span>

                            @if (providers.Flatrate.Count > 0)
                            {
                                <div class="watch-provider-group">
                                    <span class="watch-provider-group-label">@Loc.T("modal.watch.stream")</span>
                                    <div class="watch-provider-logos">
                                        @foreach (var provider in providers.Flatrate)
                                        {
                                            @if (provider.LogoUrl is not null)
                                            {
                                                <img src="@provider.LogoUrl" alt="@provider.Name" title="@provider.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="watch-provider-chip">@provider.Name</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (providers.Rent.Count > 0)
                            {
                                <div class="watch-provider-group">
                                    <span class="watch-provider-group-label">@Loc.T("modal.watch.rent")</span>
                                    <div class="watch-provider-logos">
                                        @foreach (var provider in providers.Rent)
                                        {
                                            @if (provider.LogoUrl is not null)
                                            {
                                                <img src="@provider.LogoUrl" alt="@provider.Name" title="@provider.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="watch-provider-chip">@provider.Name</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (providers.Buy.Count > 0)
                            {
                                <div class="watch-provider-group">
                                    <span class="watch-provider-group-label">@Loc.T("modal.watch.buy")</span>
                                    <div class="watch-provider-logos">
                                        @foreach (var provider in providers.Buy)
                                        {
                                            @if (provider.LogoUrl is not null)
                                            {
                                                <img src="@provider.LogoUrl" alt="@provider.Name" title="@provider.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="watch-provider-chip">@provider.Name</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (providers.Link is not null)
                            {
                                <a class="watch-provider-link" href="@providers.Link" target="_blank" rel="noopener">@Loc.T("modal.watch.more")</a>
                            }

                            <p class="watch-provider-attribution">@Loc.T("modal.watch.attribution")</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Library.Changed += HandleLibraryChanged;
        await Library.InitializeAsync();
    }

    private void HandleLibraryChanged() => InvokeAsync(StateHasChanged);

    private void HandleSearchInput(ChangeEventArgs eventArgs)
    {
        Library.SetSearchQuery(eventArgs.Value?.ToString() ?? string.Empty);
    }

    private void HandleSortChange(ChangeEventArgs eventArgs)
    {
        Library.SetSortMode(eventArgs.Value?.ToString() ?? string.Empty);
    }

    public void Dispose()
    {
        Library.Changed -= HandleLibraryChanged;
    }
}
