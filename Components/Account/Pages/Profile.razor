@page "/account/profile"
@rendermode InteractiveServer
@inject UserManager<ApplicationUser> UserManager
@inject WatchHistoryStore HistoryStore
@inject MovieLibraryState Library
@inject NavigationManager Navigation
@inject LocalizationState Loc

<PageTitle>Filmatory — @Loc.T("profile.title")</PageTitle>

@if (user is not null)
{
    <section class="panel profile-header">
        <span class="section-label">@Loc.T("profile.title")</span>
        <h2>@user.UserName</h2>
        <p class="auth-subtitle">@Loc.T("profile.subtitle")</p>

        <div class="profile-stats">
            <article>
                <strong>@history.Count</strong>
                <span>@Loc.T("profile.stat.watched")</span>
            </article>
            <article>
                <strong>@history.Count(h => h.Rating is not null)</strong>
                <span>@Loc.T("profile.stat.rated")</span>
            </article>
        </div>

        <a class="back-link" href="/">@Loc.T("profile.backHome")</a>
    </section>

    <section class="panel profile-preferences">
        <div class="section-heading compact">
            <div>
                <span class="section-label">@Loc.T("profile.preferences.title")</span>
            </div>
        </div>

        <label class="pref-toggle">
            <input type="checkbox" @bind="yearFilterEnabled" />
            <span>@Loc.T("profile.preferences.yearRange")</span>
        </label>

        @if (yearFilterEnabled)
        {
            <div class="year-range-row">
                <label>
                    <span>@Loc.T("profile.preferences.yearFrom")</span>
                    <input type="number" min="1900" max="@maxYear" @bind="yearFrom" />
                </label>
                <label>
                    <span>@Loc.T("profile.preferences.yearTo")</span>
                    <input type="number" min="1900" max="@maxYear" @bind="yearTo" />
                </label>
            </div>

            <p class="muted pref-hint">@Loc.T("profile.preferences.hint")</p>
        }

        <div class="pref-section-divider"></div>

        <label class="pref-toggle">
            <input type="checkbox" @bind="watchProviderFilterEnabled" />
            <span>@Loc.T("profile.preferences.providers.enable")</span>
        </label>

        @if (watchProviderFilterEnabled)
        {
            @if (Library.AvailableWatchProviders.Count == 0)
            {
                <p class="muted pref-hint">@Loc.T("profile.preferences.providers.empty")</p>
            }
            else
            {
                <p class="muted pref-hint">@Loc.T("profile.preferences.providers.hint")</p>

                <div class="provider-picker">
                    @foreach (var provider in Library.AvailableWatchProviders)
                    {
                        <button
                            type="button"
                            class="provider-chip @(selectedProviderIds.Contains(provider.Id) ? "is-selected" : string.Empty)"
                            title="@provider.Name"
                            @onclick="() => ToggleProvider(provider.Id)">
                            @if (provider.LogoUrl is not null)
                            {
                                <img src="@provider.LogoUrl" alt="@provider.Name" loading="lazy" />
                            }
                            else
                            {
                                <span>@provider.Name</span>
                            }
                        </button>
                    }
                </div>
            }
        }

        @if (validationError is not null)
        {
            <p class="auth-error">@validationError</p>
        }

        <button type="button" class="auth-submit pref-save" @onclick="SavePreferences">@Loc.T("profile.preferences.save")</button>

        @if (saved)
        {
            <p class="save-confirmation">@Loc.T("profile.preferences.saved")</p>
        }
    </section>

    <section class="panel profile-watchlist">
        <div class="section-heading compact">
            <div>
                <span class="section-label">@Loc.T("profile.watchlist.title")</span>
            </div>
        </div>

        @if (Library.WatchlistMovies.Count == 0)
        {
            <p class="muted">@Loc.T("profile.watchlist.empty")</p>
        }
        else
        {
            <div class="profile-history-list">
                @foreach (var movie in Library.WatchlistMovies)
                {
                    <div class="profile-history-item">
                        <div class="movie-poster small">
                            @if (movie.PosterUrl is not null)
                            {
                                <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="poster-placeholder">@movie.Title.Substring(0, 1)</span>
                            }
                        </div>

                        <div class="profile-history-body">
                            <div class="profile-history-top">
                                <strong>@movie.Title</strong>
                                <span class="year-pill">@(movie.Year?.ToString() ?? "—")</span>
                                <span class="type-tag">@(movie.Type == MediaType.Tv ? Loc.T("mediaType.tv") : Loc.T("mediaType.movie"))</span>
                            </div>
                        </div>

                        <button type="button" class="watchlist-remove-btn" @onclick="() => Library.RemoveFromWatchlist(movie.Key)">@Loc.T("profile.watchlist.remove")</button>
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel profile-history">
        <div class="section-heading compact">
            <div>
                <span class="section-label">@Loc.T("profile.history.title")</span>
            </div>
        </div>

        @if (history.Count == 0)
        {
            <p class="muted">@Loc.T("profile.history.empty")</p>
        }
        else
        {
            <div class="profile-history-list">
                @foreach (var entry in history)
                {
                    <div class="profile-history-item">
                        <div class="movie-poster small">
                            @if (entry.PosterUrl is not null)
                            {
                                <img src="@entry.PosterUrl" alt="@entry.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="poster-placeholder">@entry.Title.Substring(0, 1)</span>
                            }
                        </div>

                        <div class="profile-history-body">
                            <div class="profile-history-top">
                                <strong>@entry.Title</strong>
                                <span class="year-pill">@(entry.Year?.ToString() ?? "—")</span>
                                <span class="type-tag">@(entry.Type == MediaType.Tv ? Loc.T("mediaType.tv") : Loc.T("mediaType.movie"))</span>
                            </div>

                            <div class="profile-history-meta">
                                @if (entry.Rating is int r)
                                {
                                    <span class="rating-pill">★ @r/5</span>
                                }
                                else
                                {
                                    <span class="muted">@Loc.T("profile.history.notRated")</span>
                                }
                                <span class="muted">@Loc.T("profile.history.viewedOn") @entry.ViewedAt.ToLocalTime().ToString("d")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ApplicationUser? user;
    private List<WatchedMovie> history = [];
    private bool yearFilterEnabled;
    private int? yearFrom;
    private int? yearTo;
    private bool watchProviderFilterEnabled;
    private HashSet<int> selectedProviderIds = [];
    private string? validationError;
    private bool saved;
    private int maxYear => DateTime.Now.Year + 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthStateTask is not null ? await AuthStateTask : null;

        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/account/login?returnUrl=/account/profile", forceLoad: true);
            return;
        }

        user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }

        // Profile can be the first page visited after login, so MovieLibraryState might not
        // have loaded anything yet (watchlist, available providers) — make sure it has.
        await Library.InitializeAsync();

        yearFilterEnabled = user.YearFilterEnabled;
        yearFrom = user.PreferredYearFrom;
        yearTo = user.PreferredYearTo;

        watchProviderFilterEnabled = user.WatchProviderFilterEnabled;
        selectedProviderIds = (user.PreferredWatchProviderIds ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToHashSet();

        history = await HistoryStore.GetAllAsync(user.Id);
    }

    private void ToggleProvider(int id)
    {
        if (!selectedProviderIds.Add(id))
        {
            selectedProviderIds.Remove(id);
        }
    }

    private async Task SavePreferences()
    {
        validationError = null;
        saved = false;

        if (yearFilterEnabled && yearFrom is int f && yearTo is int t && f > t)
        {
            validationError = Loc.T("profile.preferences.invalidRange");
            return;
        }

        user!.YearFilterEnabled = yearFilterEnabled;
        user.PreferredYearFrom = yearFilterEnabled ? yearFrom : null;
        user.PreferredYearTo = yearFilterEnabled ? yearTo : null;

        user.WatchProviderFilterEnabled = watchProviderFilterEnabled;
        user.PreferredWatchProviderIds = watchProviderFilterEnabled && selectedProviderIds.Count > 0
            ? string.Join(",", selectedProviderIds)
            : null;

        await UserManager.UpdateAsync(user);

        Library.UpdateYearPreferences(user.YearFilterEnabled, user.PreferredYearFrom, user.PreferredYearTo);
        Library.UpdateWatchProviderPreferences(user.WatchProviderFilterEnabled, selectedProviderIds.ToList());

        saved = true;
    }
}
